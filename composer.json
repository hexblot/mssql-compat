{
    "name": "hexblot/mssql-compat",
    "description": "Small wrapper for PDO that emulates the deprecated mssql_* functions, and allows legacy software to work on PHP 5.3 through 8.x",
    "require": {
        "php": ">=5.3",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-pdo_dblib": "*",
        "ext-pdo_sqlite": "Only needed to run the smoke test"
    },
    "autoload": {
        "files": [
            "mssql_compat.php"
        ]
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Nick Andriopoulos",
            "email": "nand@hexblot.com",
            "homepage": "http://www.hexblot.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/hexblot/mssql-compat",
        "issues": "https://github.com/hexblot/mssql-compat/issues"
    },
    "minimum-stability": "dev",
    "scripts": {
        "test": "php tests/smoke_test.php"
    }
}
